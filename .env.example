DEBUG=True
CONSOLE=True
PYINSTALLER_LOG_LEVEL=INFO
LOGGING_LEVEL=DEBUG

# Sentry DSN for error reporting. Leave blank to disable Sentry.
# The Sentry environment is set automatically: "development" when DEVELOPMENT=True,
# "production" otherwise. Use the same DSN for both .env and .env.prod.
SENTRY_DSN=

